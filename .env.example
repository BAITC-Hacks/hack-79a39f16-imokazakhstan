# Скопируй в .env и впиши свои ключи. .env НЕ коммитить!

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Список моделей: https://platform.openai.com/docs/models
OPENAI_MODEL=gpt-5-mini

# NVIDIA — https://build.nvidia.com (OpenAI-совместимый API)
NVIDIA_API_KEY=
# Список моделей: https://build.nvidia.com/models
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
